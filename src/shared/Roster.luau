-- GENERATED by scripts/gen-roster.py from showcase/catalog.js. Do not edit by hand; edit the catalog
-- and rerun the script. Pure data (no Roblox APIs) so Lune can test it.
--
-- One creature roster per family: creatures in the order they debut (firstWave), with the stats
-- the showcase shows for that debut wave. Waves.luau scales them further per wave and party size.

export type Creature = {
	id: string,
	archetype: string, -- key into Enemies.Archetypes (size, colour, behaviour)
	firstWave: number,
	health: number,
	speed: number, -- studs per second
	damage: number, -- dealt to the Town Hall on arrival
	coins: number, -- paid to the killer before the party multiplier
	scale: number, -- body size multiplier on the archetype size
	model: string, -- asset path in the repo; swapped for a MeshPart id once imported
	flying: boolean,
}

export type Theme = {
	ground: { number },
	path: { number },
	sky: { number },
	fog: { number },
	water: { number }?,
	tower: string, -- prop name of the dungeon's tower (the Town Hall)
	towerHeight: number, -- metres in the showcase
	gate: string,
	gateHeight: number,
}

local Roster = {}

-- Family id -> ordered creature list. Family ids match Dungeons.luau `family`.
Roster.Families = {} :: { [string]: { Creature } }

