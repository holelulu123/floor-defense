function Roster.family(familyId: string): { Creature }
	local list = Roster.Families[familyId]
	assert(list, `Unknown creature family {familyId}`)
	return list
end

function Roster.theme(dungeonId: string): Theme
	local theme = Roster.Themes[dungeonId]
	assert(theme, `No theme for dungeon {dungeonId}`)
	return theme
end

-- Look a creature up by id within a family.
function Roster.get(familyId: string, creatureId: string): Creature
	for _, c in Roster.family(familyId) do
		if c.id == creatureId then
			return c
		end
	end
	error(`Unknown creature {creatureId} in family {familyId}`)
end

return Roster
