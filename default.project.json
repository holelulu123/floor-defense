{
  "name": "roblox-mod",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Packages": { "$path": { "optional": "Packages" } },
      "Remotes": {
        "$className": "Folder",
        "RunState": { "$className": "RemoteEvent" },
        "Fire": { "$className": "RemoteEvent" },
        "EquipSlot": { "$className": "RemoteEvent" },
        "Reload": { "$className": "RemoteEvent" },
        "HitFx": { "$className": "RemoteEvent" },
        "UseSkill": { "$className": "RemoteEvent" },
        "SkillFx": { "$className": "RemoteEvent" },
        "BuyClass": { "$className": "RemoteFunction" },
        "SelectClass": { "$className": "RemoteFunction" }
      }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    }
  }
}
